---
import SiteHeader from '../components/SiteHeader.astro';
import site from '../data/site.json';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>;
}

const {
  title = `${site.name} | A calmer neighborhood dentist`,
  description = site.description,
  image,
  schema,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, site.websiteUrl);
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: site.name,
  description: site.description,
  telephone: site.phoneDisplay,
  email: site.email,
  url: site.websiteUrl,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: 'US',
  },
  areaServed: ['Maplewood', 'Richmond', 'Hosford-Abernethy', 'Portland'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#315f4c" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {image && <meta property="og:image" content={image} />}
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {schema && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <span class="brand-mark brand-mark--light" aria-hidden="true"><span></span></span>
        <div>
          <strong>{site.name}</strong>
          <p>{site.socialProof}</p>
        </div>
      </div>
      <div>
        <p class="footer-label">Visit</p>
        <address>
          {site.address.street}<br />
          {site.address.locality}, {site.address.region} {site.address.postalCode}
        </address>
      </div>
      <div>
        <p class="footer-label">Contact</p>
        <a href={`tel:${site.phoneHref}`}>{site.phoneDisplay}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div>
        <p class="footer-label">Hours</p>
        {site.hours.map((item) => <p>{item.days}<br />{item.time}</p>)}
      </div>
      <p class="footer-note">
        © {new Date().getFullYear()} {site.name}. Website content is general information,
        not medical advice.
      </p>
    </footer>
  </body>
</html>
