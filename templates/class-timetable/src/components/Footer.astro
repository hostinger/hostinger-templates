---
import rawSite from '../data/site.json';
import type { SiteContent } from '../types/content';

const site = rawSite as SiteContent;
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <p class="footer-brand">{site.name}</p>
      <p class="footer-soft">{site.tagline}</p>
      <p class="footer-soft">{site.city}</p>
    </div>
    <div>
      <p class="footer-label">Visit</p>
      <p class="footer-soft">{site.address}</p>
    </div>
    <div>
      <p class="footer-label">Say hello</p>
      <div class="footer-links">
        <a href={site.phoneHref}>{site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {site.socials.map((social) => (
          <a href={social.href} rel="noopener">{social.label}</a>
        ))}
      </div>
    </div>
  </div>
  <p class="footer-fine">{site.scheduleNote}</p>
</footer>
