{
	"name": "the-big-day",
	"private": true,
	"version": "1.0.0",
	"description": "A warm, editable one-page wedding invitation with travel details, FAQs, and an honest RSVP flow.",
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^24.0.0",
		"eslint": "^10.4.1",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	}
}
