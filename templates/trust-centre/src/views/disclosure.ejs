<%- include('partials/top') %>

<section class="section subpage">
  <p class="subpage-eyebrow mono"><%= site.company.name %> · <%= site.page.title %></p>
  <div class="error-summary" role="alert">
    <h1><%= trust.disclosure.validation.errorSummaryHeading %></h1>
    <p><%= trust.disclosure.validation.errorSummaryLead %></p>
    <ul>
      <% if (formErrors.email) { %><li><a href="#disclosure-email"><%= formErrors.email %></a></li><% } %>
      <% if (formErrors.category) { %><li><a href="#disclosure-category"><%= formErrors.category %></a></li><% } %>
      <% if (formErrors.description) { %><li><a href="#disclosure-description"><%= formErrors.description %></a></li><% } %>
    </ul>
  </div>
  <div class="disclosure-form-card subpage-form-card">
    <%- include('partials/disclosure-form') %>
  </div>
  <p class="subpage-back"><a class="back-link" href="/"><%= trust.disclosure.fallback.backLabel %></a></p>
</section>

<%- include('partials/bottom') %>
