  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "lint": "eslint .",
    "preview": "node dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "nestjs",
    "handlebars",
    "typescript",
    "api-reference",
    "documentation",
    "curl"
  ],
  "dependencies": {
