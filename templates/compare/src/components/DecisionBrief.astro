---
interface Props {
  email: string;
  lastReviewed: string;
}

const { email, lastReviewed } = Astro.props;
const signupHref = `mailto:${email}?subject=${encodeURIComponent('Plainly trial request')}`;
---

<section class="brief" aria-labelledby="page-title">
  <div class="brief-index" aria-hidden="true">
    <span>Report</span>
    <strong>04/26</strong>
  </div>
  <div class="brief-copy">
    <p class="eyebrow">Decision report · Workflow software</p>
    <h1 id="page-title">Four tools.<br /><em>One honest shortlist.</em></h1>
    <p class="lede">
      Plainly is the best fit for teams that value fast setup, predictable
      pricing, and clear ownership. It is not the winner on every line.
      This report shows the trade-offs.
    </p>
    <div class="brief-actions">
      <a class="button" href="#matrix">Read the evidence</a>
      <a class="text-link" href={signupHref}>Ask a real person <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <aside class="margin-note" id="method" aria-labelledby="method-title">
    <span class="stamp">Reviewed {lastReviewed}</span>
    <h2 id="method-title">Method note</h2>
    <p>
      Ten buying criteria, weighted equally. Published base-plan details and
      hands-on product review. Vendor claims change—verify your must-haves.
    </p>
    <p class="annotation">No affiliate ranking. Plainly publishes this page.</p>
  </aside>
</section>
