---
import type { Service } from '../types/status';
import UptimeTape from './UptimeTape.astro';

interface Props {
  service: Service;
  index: number;
}

const { service, index } = Astro.props;
const uptime = service.days.reduce((sum, day) => sum + day.value, 0) / service.days.length;
const current = service.days.at(-1)?.status ?? 'operational';
---

<article class="service-row">
  <div class="service-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
  <div class="service-copy">
    <div class="service-heading">
      <div>
        <h3>{service.name}</h3>
        <p>{service.description}</p>
      </div>
      <div class="service-metric">
        <strong>{uptime.toFixed(3)}%</strong>
        <span>90-day uptime</span>
      </div>
    </div>
    <UptimeTape serviceName={service.name} days={service.days} />
    <p class={`current-state current-state--${current}`}>
      <span aria-hidden="true"></span>
      Current snapshot: {current}
    </p>
  </div>
</article>
