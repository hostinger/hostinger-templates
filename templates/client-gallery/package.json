{
  "name": "client-gallery",
  "version": "0.0.0",
  "private": true,
  "description": "Private wedding photo delivery gallery where clients star favourites and export the list for their photographer.",
  "scripts": {
    "dev": "gatsby develop",
    "build": "tsc --noEmit && gatsby build",
    "lint": "eslint .",
    "preview": "gatsby serve"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
