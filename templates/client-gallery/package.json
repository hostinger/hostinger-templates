  ],
  "license": "MIT",
  "dependencies": {
    "gatsby": "^5.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
