---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreedPicker from '../components/BreedPicker.astro';
import rawSite from '../data/site.json';
import type { SiteContent } from '../types/content';

const site = rawSite as SiteContent;
const addOns = [
  { name: 'Teeth clean', price: 9, mark: '01' },
  { name: 'Nail trim', price: 12, mark: '02' },
  { name: 'Blueberry facial', price: 8, mark: '03' },
  { name: 'De-shed boost', price: 16, mark: '04' },
];
const faqs = [
  {
    question: 'What if my dog is matted?',
    answer: 'We put comfort first. We will assess the coat with you and agree a shorter cut or extra de-matting time before the groom begins.',
  },
  {
    question: 'Is the breed price guaranteed?',
    answer: 'It is a guide for a regularly groomed dog. Coat condition, size, temperament, and requested finish can change the final quote.',
  },
  {
    question: 'Can I stay during the appointment?',
    answer: 'Most dogs settle more easily without their person in view. You are welcome to see the salon and meet the groomer at drop-off.',
  },
  {
    question: 'What should I bring?',
    answer: 'Bring your dog on a secure lead and tell us about allergies, health needs, or anything that helps them feel safe.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};
---

<BaseLayout
  title="Groom Room — Kind cuts, clear prices"
  description="Choose your dog's breed to see a real grooming guide price, appointment duration, and recommended cut."
  schema={faqSchema}
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">{site.eyebrow}</p>
      <h1>{site.headline}</h1>
      <p class="hero-intro">{site.intro}</p>
      <div class="hero-actions">
        <a class="button" href="#breed-picker">Find my dog's price</a>
        <a class="text-link" href={site.phoneHref}>Call {site.phoneDisplay}</a>
      </div>
      <div class="trust-note">
        <span aria-hidden="true">✦</span>
        <p><strong>One-to-one appointments</strong><br />No crate waiting. No rushed handover.</p>
      </div>
    </div>
    <div class="hero-image">
      <img src="/images/hero-groom.jpg" alt="Dog groomer carefully shaping a small dog's coat" width="800" height="960" />
      <div class="hero-badge">
        <span>Since</span>
        <strong>2018</strong>
        <span>North London</span>
      </div>
    </div>
  </section>

  <BreedPicker />

  <section class="add-ons" aria-labelledby="addons-title">
    <div class="section-heading light">
      <p class="eyebrow">Little extras</p>
      <h2 id="addons-title">Add a finishing touch.</h2>
      <p>Choose at drop-off. We only add what your dog needs.</p>
    </div>
    <div class="addon-list">
      {addOns.map((addOn) => (
        <article>
          <span>{addOn.mark}</span>
          <h3>{addOn.name}</h3>
          <p>+ £{addOn.price}</p>
        </article>
      ))}
    </div>
    <a class="button button-cream" href="/services">See every service</a>
  </section>

  <section class="process-section" aria-labelledby="process-title">
    <div class="section-heading">
      <p class="eyebrow">A calmer salon rhythm</p>
      <h2 id="process-title">Same groomer. Start to finish.</h2>
    </div>
    <ol class="process-list">
      <li><span>01</span><div><h3>Meet & check</h3><p>We talk coat, comfort, and the result you want.</p></div></li>
      <li><span>02</span><div><h3>Wash & work</h3><p>Your dog gets an unhurried groom with regular breaks.</p></div></li>
      <li><span>03</span><div><h3>Collect & care</h3><p>We share coat notes and a simple home-care plan.</p></div></li>
    </ol>
  </section>

  <section class="faq-section" aria-labelledby="faq-title">
    <div class="section-heading">
      <p class="eyebrow">Before the first visit</p>
      <h2 id="faq-title">Questions with straight answers.</h2>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => (
        <details open={index === 0}>
          <summary>{faq.question}<span aria-hidden="true">+</span></summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="booking-band">
    <div>
      <p class="eyebrow">Ready when they are</p>
      <h2>Tell us about your dog.</h2>
    </div>
    <div class="booking-band-actions">
      <a class="button button-cream" href={site.booking.href}>{site.booking.label}</a>
      <a href={site.phoneHref}>{site.phoneDisplay}</a>
    </div>
  </section>
</BaseLayout>
