---
import rawSite from '../data/site.json';
import type { SiteContent } from '../types/content';

const site = rawSite as SiteContent;
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true"></span>
    <span class="brand-name">{site.name}</span>
  </a>
  <nav aria-label="Main">
    {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="button button-small header-call" href={site.phoneHref}>
    <span class="call-full">Call {site.phoneDisplay}</span>
    <span class="call-short">Call us</span>
  </a>
</header>
